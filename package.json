{
  "name": "ai-news",
  "version": "1.0.0",
  "description": "AI News - Your daily source for artificial intelligence news and insights",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:chromium": "npx playwright test --project=chromium",
    "test:mobile": "npx playwright test --project=mobile-chrome",
    "test:report": "npx playwright show-report",
    "test:unit": "vitest run",
    "lint": "eslint js/ unit/",
    "serve": "npx serve . -l 3456 -s",
    "validate:schema": "node scripts/validate-news.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingfeng288/ai-news.git"
  },
  "keywords": [
    "ai",
    "news",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bingfeng288/ai-news/issues"
  },
  "homepage": "https://github.com/bingfeng288/ai-news#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.8.0",
    "serve": "^14.2.6",
    "vitest": "^4.1.10"
  }
}
